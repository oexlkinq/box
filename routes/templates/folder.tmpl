<!DOCTYPE html>
<html>

<head>
    <meta charset="UTF-8">
    <title>choose box</title>
    <style>
        body {
            place-content: center;
            min-height: 100vh;
            margin: 0;
            font-family: Arial, sans-serif;
        }

        body, form {
            display: grid;
            gap: 0.5rem;
        }

        h1 {
            margin: 0;
            font-size: 1.2rem;
            text-align: center;
        }

        input[type="file"] {
            padding: 4rem;
            border: 1px solid #aaa;
            border-radius: 4px;
        }
    </style>
</head>

<body>
    <ul>
        {{range .AbsFilePaths}}
            <li>
                <a href="{{.AbsFileUrl}}" download>{{.Url}}</a>
                |
                <a href="{{.AbsFileDelUrl}}">del</a>
            </li>
        {{else}}
            <li>Empty for now</li>
        {{end}}
    </ul>

    <form method="POST" enctype="multipart/form-data">
        <h1>
            Upload to
            <a href="{{.AbsFolderUrl}}">{{.ID}}</a>
            |
            <a href="{{.AbsFolderDelUrl}}">del</a>
        </h1>
        <input type="file" name="file" multiple required>
        <input type="submit" value="Upload">
    </form>
</body>

</html>